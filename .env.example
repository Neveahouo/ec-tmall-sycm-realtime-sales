# ===== 飞书自建应用（机器人）=====
# 复制本文件为 .env 后填写；.env 已在 .gitignore 中，不会被提交
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 卡片推送目标群（chat_id，形如 oc_xxx）
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 目标飞书表格 =====
SHEET_URL=https://your-tenant.feishu.cn/sheets/xxxxxxxxxxxxxxxx
SHEET_ID=xxxxxx
# 基准数据写入行号，后续时间点依次 +1
BASE_ROW=2
# 表格写入方式：larkcli（用本机飞书登录态）| api（需应用开通 sheets 权限）
SHEET_WRITER=larkcli

# ===== 浏览器 =====
# edge | chrome，需以 debug 模式启动（见 scripts/）
BROWSER=edge
DEBUG_PORT=9222
# 等待人工登录的秒数
LOGIN_TIMEOUT=300

# ===== 采集 =====
# 时间点列表，逗号分隔（24 小时制）
TIME_POINTS=20:00,20:05,20:10
# 卡片标题前缀
CARD_TITLE=天猫时段销售情况
